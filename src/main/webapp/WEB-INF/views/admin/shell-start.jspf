<%@ page pageEncoding="UTF-8" %>
<a class="skip-link" href="#main-content">Đi đến nội dung chính</a>
<svg class="icon-sprite" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m3 10v-3a6 6 0 0 0-3-5"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5ZM20 2v4m-2-2h4"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5Zm-9 5v9l9 5 9-5V8M12 13v9M7 5l10 6"/></symbol>
    <symbol id="i-room" viewBox="0 0 24 24"><path d="M4 21V4h13v17M2 21h20M17 9h4v12M8 8h4m-4 4h4m-4 4h4"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 2v6m10-6v6M3 11h18m-13 4h3m3 0h2"/></symbol>
    <symbol id="i-paw" viewBox="0 0 24 24"><ellipse cx="5" cy="9" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="5" rx="2" ry="3"/><ellipse cx="21" cy="10" rx="2" ry="3"/><path d="M6 18c0-3 3-7 6-7s6 4 6 7c0 5-4 1-6 1s-6 4-6-1Z"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></symbol>
</svg>
<div class="admin-shell">
    <aside class="sidebar" id="admin-sidebar">
        <%@ include file="/WEB-INF/includes/workspaceBrand.jspf" %>
        <p class="nav-caption">QUẢN LÝ HỆ THỐNG</p>
        <nav class="side-nav" aria-label="Quản trị">
            <a href="${pageContext.request.contextPath}/admin/lich-hen" ${adminPage == 'lich-hen' ? 'aria-current="page"' : ''}><svg><use href="#i-calendar"/></svg>Lịch hẹn</a>
            <a href="${pageContext.request.contextPath}/admin/bao-cao" ${adminPage == 'bao-cao' ? 'aria-current="page"' : ''}><svg><use href="#i-grid"/></svg>Báo cáo hệ thống</a>
            <a href="${pageContext.request.contextPath}/admin/tai-khoan" ${adminPage == 'tai-khoan' ? 'aria-current="page"' : ''}><svg><use href="#i-users"/></svg>Tài khoản</a>
            <a href="${pageContext.request.contextPath}/admin/dich-vu" ${adminPage == 'dich-vu' ? 'aria-current="page"' : ''}><svg><use href="#i-spark"/></svg>Dịch vụ</a>
            <a href="${pageContext.request.contextPath}/admin/combo" ${adminPage == 'combo' ? 'aria-current="page"' : ''}><svg><use href="#i-box"/></svg>Combo dịch vụ</a>
            <a href="${pageContext.request.contextPath}/admin/phong" ${adminPage == 'phong' ? 'aria-current="page"' : ''}><svg><use href="#i-room"/></svg>Phòng lưu trú</a>
            <a href="${pageContext.request.contextPath}/admin/ca-lam-viec" ${adminPage == 'ca-lam-viec' ? 'aria-current="page"' : ''}><svg><use href="#i-calendar"/></svg>Ca làm việc</a>
            <a href="${pageContext.request.contextPath}/admin/thu-cung" ${adminPage == 'thu-cung' ? 'aria-current="page"' : ''}><svg><use href="#i-paw"/></svg>Thú cưng</a>
            <a href="${pageContext.request.contextPath}/profile" ${adminPage == 'profile' ? 'aria-current="page"' : ''}><svg><use href="#i-users"/></svg>Hồ sơ cá nhân</a>
        </nav>
        <div class="sidebar-note"><svg><use href="#i-paw"/></svg><strong>Chăm sóc từ những điều nhỏ.</strong><p>Mỗi thao tác của bạn giúp PetCare vận hành tốt hơn mỗi ngày.</p></div>
        <a class="back-home" href="${pageContext.request.contextPath}/home">Về website PetCare <svg><use href="#i-arrow"/></svg></a>
        <div class="sidebar-footer"><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></div>
    </aside>
    <div class="admin-workspace">
        <header class="workspace-header">
            <div class="breadcrumb"><svg><use href="#i-grid"/></svg><span>Quản trị</span><span class="separator">/</span><strong><c:out value="${adminTitle}"/></strong></div>
            <a class="admin-identity" href="${pageContext.request.contextPath}/profile"><span class="avatar">QT</span><span><strong><c:out value="${sessionScope.currentUser.fullName}" default="Quản trị viên"/></strong><small>Quản trị viên</small></span></a>
        </header>
