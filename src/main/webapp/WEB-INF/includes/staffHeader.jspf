<%@ page pageEncoding="UTF-8" %>
<svg class="staff-icons" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<symbol id="staff-paw" viewBox="0 0 24 24"><path d="M7.5 13.5c-1.6 2-3 3.1-2.2 5.1.8 2.2 3.4 1.2 6.7 1.2s5.9 1 6.7-1.2c.8-2-.6-3.1-2.2-5.1-2.4-3-6.6-3-9 0Z"/><ellipse cx="5" cy="9" rx="2" ry="3"/><ellipse cx="10" cy="5.5" rx="2" ry="3"/><ellipse cx="15.5" cy="5.5" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="2" ry="3"/></symbol>
<symbol id="staff-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 5h2m4 0h2"/></symbol>
<symbol id="staff-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="staff-plus" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="M12 8v8m-4-4h8"/></symbol>
<symbol id="staff-person" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
<symbol id="staff-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></symbol>
<symbol id="staff-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
</svg>
<a class="skip-link" href="#staff-main">Đi đến nội dung chính</a>
<aside class="staff-sidebar">
    <a class="staff-logo" href="${pageContext.request.contextPath}/home"><span class="logo-mark"><svg aria-hidden="true"><use href="#staff-paw"/></svg></span>PetCare<span class="logo-dot">.</span></a>
    <span class="staff-tag">KHÔNG GIAN NHÂN VIÊN</span>
    <p class="nav-caption">CÔNG VIỆC CỦA BẠN</p>
    <nav class="staff-nav" aria-label="Khu vực nhân viên">
        <a href="${pageContext.request.contextPath}/staff/lich-hen" ${staffPage == 'appointments' ? 'aria-current="page"' : ''}><svg aria-hidden="true"><use href="#staff-calendar"/></svg>Lịch hẹn của tôi</a>
        <a href="${pageContext.request.contextPath}/staff/lich-lam-viec" ${staffPage == 'shifts' ? 'aria-current="page"' : ''}><svg aria-hidden="true"><use href="#staff-clock"/></svg>Lịch làm việc</a>
        <a href="${pageContext.request.contextPath}/staff/dat-lich-tai-quay" ${staffPage == 'counter' ? 'aria-current="page"' : ''}><svg aria-hidden="true"><use href="#staff-plus"/></svg>Đặt tại quầy</a>
        <a href="${pageContext.request.contextPath}/staff/thu-tien" ${staffPage == 'cash' ? 'aria-current="page"' : ''}>Thu tiền mặt</a>
        <a href="${pageContext.request.contextPath}/profile"><svg aria-hidden="true"><use href="#staff-person"/></svg>Hồ sơ cá nhân</a>
    </nav>
    <div class="sidebar-note"><svg aria-hidden="true"><use href="#staff-paw"/></svg><strong>Mỗi lần chăm sóc,<br>một niềm vui nhỏ.</strong><p>Cảm ơn bạn đã luôn tận tâm<br>với những người bạn bốn chân.</p></div>
    <div class="sidebar-bottom"><a href="${pageContext.request.contextPath}/home">Về trang chủ ↗</a><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></div>
</aside>
<header class="staff-topbar">
    <div class="staff-breadcrumb">Nhân viên <span aria-hidden="true">/</span> <strong><c:choose><c:when test="${staffPage == 'appointments'}">Lịch hẹn</c:when><c:when test="${staffPage == 'shifts'}">Lịch làm việc</c:when><c:otherwise>Đặt tại quầy</c:otherwise></c:choose></strong></div>
    <a class="staff-user" href="${pageContext.request.contextPath}/profile"><span class="user-avatar" aria-hidden="true"><svg><use href="#staff-person"/></svg></span><span><strong><c:out value="${sessionScope.currentUser.fullName}"/></strong><small>Nhân viên PetCare</small></span></a>
</header>
