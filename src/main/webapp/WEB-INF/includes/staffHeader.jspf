<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<svg class="staff-icons" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<symbol id="staff-paw" viewBox="0 0 24 24"><path d="M7.5 13.5c-1.6 2-3 3.1-2.2 5.1.8 2.2 3.4 1.2 6.7 1.2s5.9 1 6.7-1.2c.8-2-.6-3.1-2.2-5.1-2.4-3-6.6-3-9 0Z"/><ellipse cx="5" cy="9" rx="2" ry="3"/><ellipse cx="10" cy="5.5" rx="2" ry="3"/><ellipse cx="15.5" cy="5.5" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="2" ry="3"/></symbol>
<symbol id="staff-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 5h2m4 0h2"/></symbol>
<symbol id="staff-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="staff-plus" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="M12 8v8m-4-4h8"/></symbol>
<symbol id="staff-person" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
<symbol id="staff-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></symbol>
<symbol id="staff-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
</svg>
<a class="skip-link" href="#staff-main">Đi đến nội dung chính</a>
<aside class="staff-sidebar">
 <a class="figma-brand" href="${pageContext.request.contextPath}/staff/lich-hen"><span class="figma-logo"><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer23.svg" alt=""></span><span>Pet Care<small>STAFF PORTAL</small></span></a>
 <nav class="staff-nav" aria-label="Khu vực nhân viên">
 <a href="${pageContext.request.contextPath}/staff/lich-hen" ${staffPage == 'appointments' ? 'aria-current="page"' : ''}><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer24.svg" alt="">Quản lý lịch hẹn</a>
 <a href="${pageContext.request.contextPath}/staff/lich-lam-viec" ${staffPage == 'shifts' ? 'aria-current="page"' : ''}><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer25.svg" alt="">Lịch làm việc cá nhân</a>
 <a href="${pageContext.request.contextPath}/staff/dat-lich-tai-quay" ${staffPage == 'counter' ? 'aria-current="page"' : ''}><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer26.svg" alt="">Đặt lịch tại quầy</a>
 <a href="${pageContext.request.contextPath}/staff/thu-tien" ${staffPage == 'cash' ? 'aria-current="page"' : ''}><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer27.svg" alt="">Thu tiền mặt</a>
 </nav>
 <div class="sidebar-account"><a href="${pageContext.request.contextPath}/profile"><span class="user-avatar"><c:out value="${fn:substring(sessionScope.currentUser.fullName,0,1)}"/></span><span><strong><c:out value="${sessionScope.currentUser.fullName}"/></strong><small>Nhân viên PetCare</small></span></a><span class="account-label">Tài khoản nhân viên</span></div>
 <a class="staff-logout" href="${pageContext.request.contextPath}/logout"><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer28.svg" alt="">Đăng xuất</a>
</aside>
<header class="staff-topbar"><div class="staff-breadcrumb"><img src="${pageContext.request.contextPath}/assets/images/staff-figma/shifts-imgContainer.svg" alt=""><jsp:useBean id="staffClock" class="java.util.Date"/><fmt:formatDate value="${staffClock}" pattern="'Hôm nay,' dd/MM/yyyy" timeZone="Asia/Ho_Chi_Minh"/></div><div class="topbar-actions"><a class="btn btn-primary" href="${pageContext.request.contextPath}/staff/dat-lich-tai-quay">+ Đặt lịch tại quầy</a><a class="profile-shortcut" href="${pageContext.request.contextPath}/profile" aria-label="Hồ sơ cá nhân"><svg aria-hidden="true"><use href="#staff-person"/></svg></a></div></header>