<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="pc-header">
    <div class="pc-header-top">
        <a href="${pageContext.request.contextPath}/home" class="pc-brand">
            <span class="pc-brand-logo-wrap">
                <img src="${pageContext.request.contextPath}/assets/images/logo.png?v=4" alt="PetCare" />
            </span>
            <span class="pc-brand-text">
                <strong>PetCare</strong>
                <span class="pc-brand-badge">Khách hàng</span>
            </span>
        </a>

        <div class="pc-user-bar">
            <a href="${pageContext.request.contextPath}/profile" class="pc-user-chip" title="Xem hồ sơ cá nhân">
                <span class="pc-user-avatar" aria-hidden="true">
                    ${fn:toUpperCase(fn:substring(fn:trim(sessionScope.loggedInUser), 0, 1))}
                </span>
                <span class="pc-user-greeting">Xin chào, <strong>${fn:escapeXml(sessionScope.loggedInUser)}</strong></span>
            </a>

            <a href="${pageContext.request.contextPath}/home" class="pc-nav-action" title="Về trang chủ">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Trang chủ</span>
            </a>

            <a href="${pageContext.request.contextPath}/logout" class="pc-logout-link" title="Đăng xuất">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Đăng xuất</span>
            </a>
        </div>
    </div>

    <nav class="pc-subnav-wrap" aria-label="Menu khách hàng">
        <div class="pc-subnav">
            <a href="${pageContext.request.contextPath}/customer/dat-lich"
               class="${activeCustomerNav == 'booking' ? 'active' : ''}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Đặt lịch</span>
            </a>
            <a href="${pageContext.request.contextPath}/customer/lich-hen"
               class="${activeCustomerNav == 'appointments' ? 'active' : ''}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                <span>Lịch hẹn của tôi</span>
            </a>
            <a href="${pageContext.request.contextPath}/customer/thu-cung"
               class="${activeCustomerNav == 'pets' ? 'active' : ''}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <circle cx="11" cy="4" r="2"></circle>
                    <circle cx="18" cy="8" r="2"></circle>
                    <circle cx="20" cy="16" r="2"></circle>
                    <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>
                </svg>
                <span>Thú cưng của tôi</span>
            </a>
            <a href="${pageContext.request.contextPath}/customer/thanh-toan"
               class="${activeCustomerNav == 'payments' ? 'active' : ''}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <rect x="1" y="4" width="22" height="16" rx="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
                <span>Thanh toán</span>
            </a>
            <a href="${pageContext.request.contextPath}/customer/danh-gia"
               class="${activeCustomerNav == 'reviews' ? 'active' : ''}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span>Đánh giá</span>
            </a>
            <a href="${pageContext.request.contextPath}/customer/thong-bao"
               class="${activeCustomerNav == 'notifications' ? 'active' : ''}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span>Thông báo</span>
            </a>
            <a href="${pageContext.request.contextPath}/profile">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Hồ sơ &amp; Mật khẩu</span>
            </a>
        </div>
    </nav>
</header>
